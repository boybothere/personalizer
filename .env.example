# Copy to .env and fill in. Never commit .env (it is git-ignored).

# --- Search providers (comma-separated, tried in order). Options: tavily, exa, brave, wikipedia, fixture
#     "fixture" uses the offline synthetic corpus in eval/fixtures/corpus.json (no network, no keys).
PERSONALIZER_SEARCH_PROVIDERS=fixture
TAVILY_API_KEY=            # https://app.tavily.com  - 1,000 free credits/month, no card
EXA_API_KEY=               # https://dashboard.exa.ai - $10 free credit/month
BRAVE_API_KEY=             # https://api-dashboard.search.brave.com - $5 credit/month, card required
BRAVE_STORAGE_RIGHTS=false # set true only if your Brave plan includes storage rights

# --- Contact details for the User-Agent (URL or email). Required by Wikimedia; good practice everywhere.
PERSONALIZER_CONTACT=

# --- LLM: "none" = offline heuristic mode (free); "anthropic" = Claude extraction and synthesis (paid)
PERSONALIZER_LLM=none
ANTHROPIC_API_KEY=
PERSONALIZER_MODEL=claude-opus-5-5   # or claude-sonnet-5-5 / claude-haiku-5-5 to cut cost
PERSONALIZER_LLM_EFFORT=low
PERSONALIZER_MAX_COST_USD=0.75       # hard per-run LLM budget; extraction falls back to heuristics beyond it

# --- Limits, storage and access
PERSONALIZER_MAX_FETCHES=12
PERSONALIZER_RESULTS_PER_QUERY=5
PERSONALIZER_DB_PATH=data/personalizer.db
PERSONALIZER_RETENTION_DAYS=30
PERSONALIZER_API_TOKEN=              # if set, API calls need "Authorization: Bearer <token>"

# --- Optional source-policy extensions (comma-separated domains)
PERSONALIZER_EXTRA_REPUTABLE_DOMAINS=dailytech.example,businessherald.example   # demo-corpus news sites; replace for real use
PERSONALIZER_EXTRA_BLOCKED_DOMAINS=
